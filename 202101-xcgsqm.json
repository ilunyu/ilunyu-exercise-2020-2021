  "question": [
    {
      "type": "regular",
      "text": "阅读下面《论语》中的文字，回答问题。",
      "format": {}
    },
    {
      "type": "material",
      "sourceid": 510,
      "sourcename": "《公冶长》",
      "paragraphs": [
        {
          "text": "子曰：“始吾于人也，听其言而信其行；今吾于人也，听其言而观其行。”",
          "format": {}
        }
      ]
    },
    {
      "type": "material",
      "sourceid": 407,
      "sourcename": "《里仁》",
      "paragraphs": [
        {
          "text": "子曰：“人之过也，各于其党①。观过，斯知仁②矣。”",
          "format": {}
        }
      ]
    },
    {
      "type": "material",
      "sourceid": 1528,
      "sourcename": "《卫灵公》",
      "paragraphs": [
        {
          "text": "子曰：“众恶之，必察焉；众好之，必察焉。”",
          "format": {}
        }
      ]
    },
    {
      "type": "note",
      "text": "注释：①党：类。②仁：同“人”。",
      "format": {}
    },
    {
      "type": "regular",
      "text": "综合以上材料，简述孔子对“知人”的认识，并选择其中一点谈谈对你的启示。",
      "format": {}
    }
  ],
  "answer": [
    {
      "type": "regular",
      "text": "参考答案：",
      "format": {}

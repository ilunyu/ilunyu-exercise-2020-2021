  "question": [
    {
      "type": "regular",
      "text": "阅读下面《论语》中的文字，回答问题。",
      "format": {}
    },
    {
      "type": "material",
      "sourceid": 214,
      "sourcename": "《为政》",
      "paragraphs": [
        {
          "text": "子曰：“君子周而不比，小人比而不周。”",
          "format": {}
        }
      ]
    },
    {
      "type": "material",
      "sourceid": 416,
      "sourcename": "《里仁》",
      "paragraphs": [
        {
          "text": "子曰：“君子喻于义，小人喻于利。”",
          "format": {}
        }
      ]
    },
    {
      "type": "material",
      "sourceid": 737,
      "sourcename": "《述而》",
      "paragraphs": [
        {
          "text": "子曰：“君子坦荡荡，小人长戚戚。”",
          "format": {}
        }
      ]
    },
    {
      "type": "material",
      "sourceid": 1216,
      "sourcename": "《颜渊》",
      "paragraphs": [
        {
          "text": "子曰：“君子成人之美，不成人之恶，小人反是。”",
          "format": {}
        }
      ]
    },
    {
      "type": "material",
      "sourceid": 1323,
      "sourcename": "《子路》",
      "paragraphs": [
        {
          "text": "子曰：“君子和而不同，小人同而不和。”",
          "format": {}
        }
      ]
    },
    {
      "type": "regular",
      "text": "在《论语》中，孔子常把“君子”与“小人”进行对比。请你综合以上材料，概括出“君子”有哪些特点。",
      "format": {}
    }
  ],
  "answer": [
    {
      "type": "regular",
      "text": "团结他人；重义轻利；胸怀坦荡；成人之美；与人和睦相处，而不盲目附和。",
      "format": {}
    }
  ]
